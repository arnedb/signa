# Copy to .env.pro in the deploy folder on the server. Never commit the real file.
SIGNA_ENVIRONMENT=pro
SIGNA_HOST=signa.arnedb.be
# Set by deploy/deploy.sh on every deploy:
SIGNA_IMAGE=ghcr.io/arnedb/signa:pro
# Never demo data in pro (the app refuses to start with it).
SIGNA_SEED_DEMO=false
SIGNA_BACKUP_KEEP=30

# Traefik on arnedb.be: cert resolver "le", entrypoint "websecure".
TRAEFIK_CERTRESOLVER=le
TRAEFIK_ENTRYPOINT=websecure
# The Docker network Traefik uses on arnedb.be.
TRAEFIK_NETWORK=proxy
