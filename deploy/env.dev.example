# Copy to .env.dev in the deploy folder on the server. Never commit the real file.
VGT_ENVIRONMENT=dev
VGT_HOST=signa-dev.arnedb.be
# Optional: the old host, redirected to VGT_HOST with the same path (compose.redirect.yaml).
# Remove the line once nobody uses the old address any more.
VGT_OLD_HOST=vgt-dev.arnedb.be
# Set by deploy/deploy.sh on every deploy:
VGT_IMAGE=ghcr.io/arnedb/vgt-practice:dev
# Dev starts with demo users and words when its database is empty.
VGT_SEED_DEMO=true
VGT_BACKUP_KEEP=7

# Traefik on arnedb.be: cert resolver "le", entrypoint "websecure".
TRAEFIK_CERTRESOLVER=le
TRAEFIK_ENTRYPOINT=websecure
# The Docker network Traefik uses on arnedb.be.
TRAEFIK_NETWORK=proxy
